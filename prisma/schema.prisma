
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TECHNICIAN
  SUPERVISOR
  MANAGER
}

enum ToolStatus {
  AVAILABLE
  CHECKED_OUT
  MAINTENANCE
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(TECHNICIAN)
  createdAt    DateTime  @default(now())

  checkouts    Checkout[]
  adjustments  InventoryAdjustment[]
}

model Tool {
  id          String     @id @default(cuid())
  name        String
  category    String
  location    String
  status      ToolStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())

  checkouts   Checkout[]
}

model Checkout {
  id            String    @id @default(cuid())
  toolId        String
  userId        String
  checkedOutAt  DateTime  @default(now())
  dueAt         DateTime
  returnedAt    DateTime?

  tool          Tool      @relation(fields: [toolId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
}

model InventoryItem {
  id                String   @id @default(cuid())
  name              String
  category          String
  quantity          Int
  reorderThreshold  Int
  location          String
  createdAt         DateTime @default(now())

  adjustments       InventoryAdjustment[]
}

model InventoryAdjustment {
  id                String   @id @default(cuid())
  itemId            String
  userId            String
  changeAmount      Int
  resultingQuantity Int
  note              String?
  createdAt         DateTime @default(now())

  item              InventoryItem @relation(fields: [itemId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
}