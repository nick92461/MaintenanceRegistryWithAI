// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  TECHNICIAN
  SUPERVISOR
  MANAGER
}

enum ToolStatus {
  AVAILABLE
  CHECKED_OUT
  MAINTENANCE
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  properties Property[]
  users      User[]
}

model Property {
  id        String   @id @default(cuid())
  companyId String
  name      String
  joinCode  String   @unique
  createdAt DateTime @default(now())

  company        Company               @relation(fields: [companyId], references: [id])
  memberships    PropertyMembership[]
  tools          Tool[]
  inventoryItems InventoryItem[]
  checkouts      Checkout[]
  adjustments    InventoryAdjustment[]

  @@index([companyId])
}

model User {
  id                 String    @id @default(cuid())
  companyId          String
  name               String
  email              String    @unique
  passwordHash       String
  isCompanyAdmin     Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  deletedAt          DateTime?

  company     Company               @relation(fields: [companyId], references: [id])
  memberships PropertyMembership[]
  sessions    Session[]
  checkouts   Checkout[]
  adjustments InventoryAdjustment[]

  @@index([companyId])
}

model PropertyMembership {
  userId     String
  propertyId String
  role       Role     @default(GUEST)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@id([userId, propertyId])
  @@index([propertyId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Tool {
  id         String     @id @default(cuid())
  propertyId String
  name       String
  category   String
  location   String
  status     ToolStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now())
  deletedAt  DateTime?

  property  Property   @relation(fields: [propertyId], references: [id])
  checkouts Checkout[]

  @@index([propertyId])
}

model Checkout {
  id           String    @id @default(cuid())
  propertyId   String
  toolId       String
  userId       String
  checkedOutAt DateTime  @default(now())
  dueAt        DateTime
  returnedAt   DateTime?

  property Property @relation(fields: [propertyId], references: [id])
  tool     Tool     @relation(fields: [toolId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([propertyId])
}

model InventoryItem {
  id               String    @id @default(cuid())
  propertyId       String
  name             String
  category         String
  quantity         Int
  reorderThreshold Int
  location         String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  property    Property              @relation(fields: [propertyId], references: [id])
  adjustments InventoryAdjustment[]

  @@index([propertyId])
}

model InventoryAdjustment {
  id                String   @id @default(cuid())
  propertyId        String
  itemId            String
  userId            String
  changeAmount      Int
  resultingQuantity Int
  note              String?
  createdAt         DateTime @default(now())

  property Property      @relation(fields: [propertyId], references: [id])
  item     InventoryItem @relation(fields: [itemId], references: [id])
  user     User          @relation(fields: [userId], references: [id])

  @@index([propertyId])
}